rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- yardımcılar ----
    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function active() { return hasProfile() && get(profilePath()).data.active == true; }
    function isAdmin() { return active() && get(profilePath()).data.role == 'admin'; }
    function isEditor() { return active() && get(profilePath()).data.role == 'editor'; }
    function isStaff() { return isAdmin() || isEditor(); }
    function isModerator() { return active() && get(profilePath()).data.role == 'moderator'; }
    function canModerate() { return isAdmin() || isModerator(); }

    // ---- kullanıcılar ----
    // Profil kaydı: yönetici oluşturur/günceller. Davet edilen kişi, doğrulanmış e-postasıyla
    // yalnızca davetteki rolle kendi kaydını oluşturabilir.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        request.auth.uid == uid
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()))
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'active'])
        && request.resource.data.role ==
           get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.role
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.active == true
      );
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /invites/{email} {
      allow read, write: if isAdmin();
      allow get: if signedIn() && request.auth.token.email_verified == true
                 && request.auth.token.email.lower() == email;
    }

    // ---- vefat ilanları ----
    function vefatOk(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() < 120
        && (d.photo == null || (d.photo is string && d.photo.size() < 700000))
        && d.status in ['draft', 'pending', 'published', 'rejected', 'archived']
        // aile onayı olmadan onaya gönderilemez / yayınlanamaz
        && (!(d.status in ['pending', 'published']) || d.familyConsent == true);
    }

    match /vefat/{id} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow create: if isStaff()
        && request.resource.data.createdBy == request.auth.uid
        && (isAdmin() || request.resource.data.status == 'draft')
        && vefatOk(request.resource.data);
      allow update: if isStaff() && vefatOk(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          (isAdmin() && resource.data.status != 'archived')
          || (isEditor()
              && resource.data.createdBy == request.auth.uid
              && resource.data.status in ['draft', 'rejected']
              && request.resource.data.status in ['draft', 'pending'])
        );
      allow delete: if false;
    }

    // ---- haberler ----
    function newsOk(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() < 200
        && d.kind in ['haber', 'duyuru', 'kesinti']
        && d.status in ['draft', 'published', 'archived']
        && (d.photo == null || (d.photo is string && d.photo.size() < 700000));
    }

    match /news/{id} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow create: if isStaff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status in ['draft', 'published']
        && newsOk(request.resource.data);
      allow update: if isStaff() && newsOk(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && resource.data.status != 'archived'
        && (isAdmin() || request.resource.data.status in ['draft', 'published']);
      allow delete: if false;
    }

    // ---- nöbetçi eczane: herkes okur, yönetici/editör yazar ----
    function pharmacyOk(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() < 120
        && d.phone is string && d.phone.size() <= 20
        && d.active is bool;
    }

    match /pharmacies/{id} {
      allow read: if true;
      allow create, update: if isStaff() && pharmacyOk(request.resource.data);
      allow delete: if false;
    }

    function dutyOk(d, date) {
      return d.date == date && d.date.size() == 10
        && d.pharmacyIds is list && d.pharmacyIds.size() <= 10;
    }

    match /duty/{date} {
      allow read: if true;
      allow create, update: if isStaff() && dutyOk(request.resource.data, date);
      allow delete: if false;
    }

    // ---- etkinlik, rehber, yerel esnaf: yayında olanı herkes okur; yönetici/editör yazar, silme yok ----
    function contentOk(d) {
      return d.published is bool
        && d.updatedBy == request.auth.uid
        && (!('photo' in d) || d.photo == null || (d.photo is string && d.photo.size() < 700000));
    }

    match /events/{id} {
      allow read: if resource.data.published == true || isStaff();
      allow create, update: if isStaff() && contentOk(request.resource.data)
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.date is string && request.resource.data.date.size() == 10;
      allow delete: if false;
    }

    match /guide/{id} {
      allow read: if resource.data.published == true || isStaff();
      allow create, update: if isStaff() && contentOk(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20;
      allow delete: if false;
    }

    match /businesses/{id} {
      allow read: if resource.data.published == true || isStaff();
      allow create, update: if isStaff() && contentOk(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() > 0;
      allow delete: if false;
    }


    // ---- genel sohbet: yalnızca giriş yapmış üyeler okur ve yazar ----
    // Üye yalnızca kendi adına, en fazla 500 karakterlik mesaj yazar; susturulmuş üye yazamaz.
    // Üye kendi mesajını siler; yönetici/moderatör mesajı gizler (silmez) ve şikâyetleri yönetir.
    match /chat/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt', 'hidden'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.hidden == false
        && !exists(/databases/$(database)/documents/mutes/$(request.auth.uid));
      allow update: if canModerate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']);
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || canModerate();
    }

    // Şikâyet: belge kimliği "<şikâyet eden>_<mesaj>" olduğundan aynı kişi aynı mesajı bir kez bildirir.
    match /chatReports/{id} {
      allow read: if canModerate();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['messageId', 'messageUid', 'messageName', 'text', 'reporterUid', 'reason', 'handled', 'createdAt',
              'source', 'newsId'])
        && request.resource.data.reporterUid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.messageId
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 100
        && request.resource.data.handled == false
        && request.resource.data.createdAt == request.time;
      allow update: if canModerate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handled']);
      allow delete: if false;
    }

    // Susturulan üyeler: belge kimliği üyenin uid'sidir.
    match /mutes/{uid} {
      allow read: if canModerate() || (signedIn() && request.auth.uid == uid);
      allow create: if canModerate() && request.resource.data.by == request.auth.uid
        && request.resource.data.name is string;
      allow update: if false;
      allow delete: if canModerate();
    }

    // ---- şikâyet / öneri: üye kendi mesajını gönderir ve okur; yönetici/moderatör hepsini görür, durum ve yanıt yazar ----
    match /complaints/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || canModerate());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'email', 'category', 'neighborhood', 'text', 'status', 'reply', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0 && request.resource.data.category.size() <= 40
        && request.resource.data.neighborhood is string && request.resource.data.neighborhood.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 1000
        && request.resource.data.status == 'new'
        && request.resource.data.reply == ''
        && request.resource.data.createdAt == request.time;
      allow update: if canModerate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'updatedAt', 'handledBy'])
        && request.resource.data.status in ['new', 'progress', 'resolved', 'closed']
        && request.resource.data.reply is string && request.resource.data.reply.size() <= 1000;
      allow delete: if false;
    }

    // ---- haber yorumları: yayındaki haberde herkes okur, giriş yapan üye yazar ----
    // Gizlenen yorumu yalnızca moderatör/yönetici okur. Yorum kapatılmış (commentsOpen == false) haberde
    // ve susturulmuş üyeye yazma yok. Üye kendi yorumunu siler; moderatör gizler.
    match /comments/{id} {
      allow read: if resource.data.hidden == false || canModerate();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['newsId', 'uid', 'name', 'text', 'createdAt', 'hidden'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.newsId is string
        && request.resource.data.newsId.size() > 0 && request.resource.data.newsId.size() <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time
        && request.resource.data.hidden == false
        && !exists(/databases/$(database)/documents/mutes/$(request.auth.uid))
        && get(/databases/$(database)/documents/news/$(request.resource.data.newsId)).data.status == 'published'
        && get(/databases/$(database)/documents/news/$(request.resource.data.newsId)).data.get('commentsOpen', true) == true;
      allow update: if canModerate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']);
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || canModerate();
    }

    // ---- bildirim kayıtları (sunucu kodu bunları telefonlara gönderecek) ----
    match /notices/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }
  }
}
