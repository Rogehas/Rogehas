rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function staff() {
      let p = firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
      return request.auth != null && p.data.active == true && p.data.role in ['admin', 'editor'];
    }

    // Vefat ve haber fotoğrafları: herkes görür, yalnızca yönetici/editör yükler.
    match /{kind}/{id}/{file} {
      allow read: if kind in ['vefat', 'news'];
      allow write: if kind in ['vefat', 'news'] && staff()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
